# コスめぐり ローカル設定テンプレート
# 実キーはコミットしない（本番は Secret Manager から Cloud Run へ注入する）
# コピーして使う: cp .env.example .env

# --- プロバイダ切り替え（既定は全て mock。キーが無い live は自動で mock に落ちる） ---
VTO_MODE=mock            # mock | live
TRANSIT_MODE=mock        # mock | live
LLM_MODE=mock            # mock | live
REPOSITORY=firestore     # firestore（既定）| memory（テスト専用・再起動で消える）

# --- 認証（ログイン画面は自作、資格情報は Firebase Authentication に預ける） ---
# dev はコス名を入れるだけでログインできる開発用（パスワード検証なし）。
# APP_ENV が local/test 以外のときは firebase を必須にしている。
AUTH_MODE=dev            # dev | firebase
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=    # 公開前提の web API キー（フロントのログイン画面が使う）
DEV_AUTH_SECRET=cos-meguri-local-development-secret-key-0001

# --- バッチ用エンドポイント（Cloud Scheduler から叩く）の共有シークレット ---
# PWA を公開するとサービス全体が未認証許可になるため、/api/tasks/* だけ
# アプリ側で突き合わせる。未設定だとローカルは通るが、本番では閉じる。
TASKS_TOKEN=

# --- YouCam API（試着・Fitzpatrick肌タイプ・顔属性） ---
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=

# --- 駅すぱあと API（MCPサーバー） ---
EKISPERT_API_KEY=
EKISPERT_MCP_URL=

# --- Gemini API ---
GOOGLE_API_KEY=
# 最新: gemini-3.7-flash / 低コスト: gemini-3.5-flash-lite
# 旧世代も指定可（gemini-2.5-flash）。gemini-2.0-* は提供終了
GEMINI_MODEL=gemini-3.7-flash

# モデルIDは console の表記に合わせて上書きできる

# --- GCP ---
GOOGLE_CLOUD_PROJECT=cos-meguri-local
# ローカルは compose のエミュレータを見る（compose 側で既定値を入れている）。
# 本番（Cloud Run）では絶対に設定しないこと。実 Firestore に繋がらなくなる
FIRESTORE_EMULATOR_HOST=
# エミュレータのホスト側ポート（既定 8210）
FIRESTORE_PORT=
