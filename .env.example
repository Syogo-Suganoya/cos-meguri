# --- プロバイダ切り替え（既定は全て mock。キーが無い live は自動で mock に落ちる） ---
EKISPERT_MODE=mock       # 経路（駅すぱあと）                    mock | live
GEMINI_MODE=mock         # 言い回し・翻訳・補足（Gemini）        mock | live
REPOSITORY=firestore     # firestore（既定）| memory（テスト専用・再起動で消える）

# --- 認証（ログイン画面は自作、資格情報は Firebase Authentication に預ける） ---
# ローカルは compose が認証エミュレータ（firebase-auth）を一緒に立て、設定も compose 側で入れる。
# ここで触るのはホスト側のポートだけ
AUTH_EMULATOR_PORT=      # 既定 9099

# --- 駅すぱあと API（MCPサーバー） ---
# キーは駅すぱあと API のアクセスキー。MCP 専用のものは無い。
# 持っていなければ90日無料評価版: https://api-info.ekispert.com/form/trial/
# MCP 経由でも通常どおりアクセス数と使用料が加算される
EKISPERT_API_KEY=
# ホスト型の固定URL。自前で立てる必要はない
EKISPERT_MCP_URL=https://api-mcp.ekispert.jp/mcp

# --- Gemini API ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- GCP ---
GOOGLE_CLOUD_PROJECT=cos-meguri-local
# ローカルは compose のエミュレータを見る（compose 側で既定値を入れている）。
# 本番（Cloud Run）では絶対に設定しないこと。実 Firestore に繋がらなくなる
FIRESTORE_EMULATOR_HOST=
# エミュレータのホスト側ポート（既定 8210）
FIRESTORE_PORT=
